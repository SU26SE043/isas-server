# ISAS — Server .env (mẫu) — đặt CẠNH docker-compose.yml trên server, `chmod 600`.
# Copy → `.env`, điền giá trị THẬT. KHÔNG commit `.env` thật (đã gitignore).
# ⚠ Docker: giá trị KHÔNG bọc dấu nháy (compose truyền nguyên cả "..." vào biến).
# Chi tiết deploy: DEPLOYMENT.md. Secret phải KHỚP: xem DEPLOYMENT.md §3.

# ===== Tag image (đường ROLLBACK) =====
# 6 service .NET/AI đọc `ghcr.io/su26se043/isas.<svc>:${IMAGE_TAG:-main}`.
# Bỏ trống / không khai = `main` = hành vi như trước, không phá gì.
# CI nay đẩy TAG ĐÔI: `:main` (di động) + `:main-<sha>` (BẤT BIẾN). Muốn lùi về một bản
# đã biết là tốt: đặt IMAGE_TAG=main-<sha> rồi `docker compose up -d` — không phải đợi CI
# build lại ~15 phút. Job deploy tự ghi đè dòng này mỗi lần deploy để `up -d` chạy tay sau
# đó không âm thầm rơi về `:main`. Chi tiết + giới hạn: DEPLOYMENT.md §Rollback.
IMAGE_TAG=main

# ===== Postgres (container local) =====
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# ===== JWT (PHẢI GIỐNG HỆT ở auth · interview · campaign · payment) =====
# Interview/Campaign/Payment validate token do Auth phát bằng chung key này.
JWT_KEY=change-me-long-random-secret

# ===== Internal token (PHẢI GIỐNG interview ↔ aiworker ↔ payment) =====
# Xác thực callback máy-máy /internal/... (không JWT).
INTERNAL_TOKEN=change-me-internal-token

# ===== SeaweedFS S3 (khớp seaweed-s3.json + aiapi/aiworker) =====
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me-s3-secret

# ===== RabbitMQ =====
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ===== SMTP (AuthService gửi email OTP / reset) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
SMTP_FROM=no-reply@example.com

# ===== Google OAuth (AuthService login-google) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Origin app FE — callback Google 302 về {FRONTEND_PUBLIC_URL}/auth/google/callback kèm MÃ DÙNG-MỘT-LẦN
# (?code=…), KHÔNG kèm token; FE đổi mã lấy phiên qua POST /auth/google/exchange.
# BẮT BUỘC lấy từ config server: nhận đích redirect do client truyền = open-redirect làm rò phiên.
# CÙNG biến này còn là `Invitation__BaseUrl` của campaignservice (magic-link mời B2B = {origin}/invite/{token}).
# ⚠ Tên biến khớp .env ĐANG CHẠY trên server. DEPLOYMENT.md §4 còn ghi tên cũ `FRONTEND_BASE_URL` — chưa hợp nhất.
FRONTEND_PUBLIC_URL=https://your-frontend
# Tuỳ chọn — hạn sống (giây) của mã dùng-một-lần. Không set = 60; ngoài [5, 600] bị kẹp.
# ⚠ Mã giữ trong BỘ NHỚ tiến trình AuthService → chỉ đổi được ở đúng instance đã phát; chạy nhiều
# instance phải bật sticky session hoặc chuyển kho mã sang Redis/DB.
GOOGLE_ONETIME_CODE_TTL_SECONDS=60
# Origin CÔNG KHAI của gateway KÈM /api/v1 — dùng dựng redirect_uri gửi Google (gateway strip tiền tố
# nên URL handler tự dựng sẽ thiếu /api/v1 và 404 ở edge). Phải khớp "Authorized redirect URI" khai
# trên Google Cloud Console: {GOOGLE_PUBLIC_BASE_URL}/auth/signin-google
# ⚠ Tên biến khớp .env ĐANG CHẠY trên server. DEPLOYMENT.md §4 còn ghi tên cũ `GATEWAY_PUBLIC_BASE_URL`.
GOOGLE_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com/api/v1
# ===== Google NATIVE (app mobile) — POST /auth/google/id-token =====
# App không đi vòng redirect: nó tự lấy ID token bằng Google Sign-In SDK rồi POST thẳng lên server.
# KHÔNG cần env mới cho trường hợp thường: allowlist `aud` để trống sẽ rơi về GOOGLE_CLIENT_ID ở trên.
# ⚠ App PHẢI xin ID token với serverClientId = GOOGLE_CLIENT_ID (WEB client id), KHÔNG phải Android/iOS
#   client id — `aud` của token chính là giá trị đó. Đặt nhầm ⇒ server trả 401 mà không rõ vì sao (log
#   của AuthService in ra allowlist đang cấu hình để đối chiếu).
# ⚠ Android/iOS client (kèm SHA-1) vẫn phải tạo trên Google Cloud Console để Google xác thực APP;
#   mỗi keystore một SHA-1 (debug từng máy dev · release · Play App Signing) → tạo nhiều client cùng
#   package name. SHA-1 khoá theo CHỮ KÝ APK, không giới hạn số điện thoại cài.
# Chỉ set khi app cố tình xin token với audience khác web client id (phân tách bằng dấu phẩy → mỗi giá
# trị một biến ...__0, ...__1). Trống CẢ hai (biến này + GOOGLE_CLIENT_ID) ⇒ endpoint trả 500 chứ KHÔNG
# bỏ qua kiểm tra: aud rỗng nghĩa là mọi Google ID token trên đời đều đăng nhập được.
# - Authentication__Google__IdTokenAudiences__0=<aud-khac-neu-co>

# ===== PayOS (PaymentService — mua credit + webhook) =====
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# BF3 — bắt buộc: PayOS reject tạo payment-link nếu return/cancel URL null. URL FE/tunnel redirect sau thanh toán.
PAYOS_RETURN_URL=https://your-frontend-or-tunnel/payment/success
PAYOS_CANCEL_URL=https://your-frontend-or-tunnel/payment/cancel

# ===== Hoàn tiền tự động qua kênh CHI payOS =====
# ⚠ Credential RIÊNG của "Kênh chuyển tiền" (my.payos.vn → Chi → Kênh chuyển tiền), KHÔNG dùng
# chung với kênh thu ở trên: key kênh thu gọi API chi trả code 601 "API key không tồn tại".
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
# Mặc định TẮT. Đây là đường DUY NHẤT tự chuyển tiền RA khỏi tài khoản công ty — chỉ bật sau khi
# kênh chi đã đối soát xong. Bật = true.
REFUND_PAYOUT_ENABLED=false
# Trần mỗi lệnh chi tự động (VND). Vượt trần → admin chuyển tay. 0 = chặn mọi lệnh tự động.
REFUND_PAYOUT_MAX_VND=2000000

# ===== Suất dùng thử B2C (F7) =====
# Số credit tặng khi TẠO ví của một User (chỉ owner_type=User; ví Org KHÔNG có suất dùng thử).
# Bỏ trống = mặc định 3. Đặt 0 = TẮT hẳn (user mới quay lại nhận 402 như trước F7).
# Đổi giá trị KHÔNG hồi tố: ví đã tạo giữ nguyên free_credits_granted của nó.
# → map vào Billing__FreeTrialCredits của paymentservice trong compose.
FREE_TRIAL_CREDITS=3

# ===== Tiered subscription rollout (D28) =====
# Giữ cả hai false cho deploy/staging regression. Chỉ bật TIERING_ENABLED sau khi migration,
# preflight và E2E staging xanh; tuyệt đối không bật unlimited cho capstone.
TIERING_ENABLED=false
TIERING_ALLOW_UNLIMITED_PLANS=false

# ===== Phỏng vấn THÍCH ỨNG (INT-17 / INT-17b) =====
# Trước đây 3 khoá đầu chỉ tồn tại trong compose sửa TAY trên server ⇒ hình dạng buổi phỏng vấn chạy thật
# chỉ đọc được bằng `docker inspect`. Đưa vào đây để cấu hình production có trong version control.
#
# ⚠ KILL-SWITCH là ADAPTIVE_MAX_DEEP_PER_QUESTION:
#   >0 = chế độ CHUỖI (mỗi câu gốc đào sâu tối đa ngần đó tầng, xen kẽ ngay sau nó);
#    0 = chế độ frontier trước INT-17b (lúc đó ADAPTIVE_MAX_FOLLOW_UPS mới có hiệu lực — ở chế độ chuỗi
#        code tự ép nó về 0, nên đừng đặt 0 ở đây để "tắt", làm vậy là bỏ trần buổi).
# Tắt hẳn phỏng vấn thích ứng (về luồng batch tĩnh): ADAPTIVE_ENABLED=false.
#
# SEED_COUNT là TRẦN TRÊN của số câu gốc; số thực tế = ceil(trần buổi / (1 + độ sâu)), vì ứng viên chọn
# "số câu" là chọn TỔNG số câu của buổi (F2b) — 5 gốc trong một buổi trần 5 câu thì không còn khe nào để
# đào sâu. Trần 20 → 5 gốc · 10 → 3 · 5 → 2.
ADAPTIVE_ENABLED=false
ADAPTIVE_SEED_COUNT=5
ADAPTIVE_MAX_QUESTIONS=20
ADAPTIVE_MAX_FOLLOW_UPS=3
ADAPTIVE_MAX_DEEP_PER_QUESTION=3
ADAPTIVE_MAX_FAILURES_PER_SESSION=3

# Buổi luyện trong BÀI HỌC ROADMAP là đường RIÊNG, cố ý TĨNH — không đọc khối ADAPTIVE_* ở trên.
# Bài học đã có `focusCriteria` khoanh sẵn chủ đề nên đào sâu ở đó ít giá trị hơn buổi luyện tự
# do, còn số câu bập bênh (5 gốc + chuỗi đào sâu + câu bù tự động) làm người học không lường
# trước được thời lượng. Mặc định đã đúng — không bắt buộc đặt 2 khoá này.
ROADMAP_LESSON_QUESTION_COUNT=5
ROADMAP_LESSON_ADAPTIVE_ENABLED=false

# Trần BỎ CUỘC cho answer đang chờ chấm (phút, tính từ lúc TẠO answer — KHÔNG phải từ mốc publish,
# mốc đó bị chính vòng đẩy-lại dời nên trần sẽ không bao giờ tới). Quá hạn → thôi đẩy lại, chốt sổ
# bằng attempt đã có (hoặc Skipped nếu chưa có attempt nào) rồi đóng buổi.
# ⚠ 0 = TẮT = quay lại hành vi cũ: buổi kẹt `Scoring` VĨNH VIỄN, credit treo `Reserved` không ai
# hoàn (sự cố prod 2026-08-15).
# 🔴 ĐI CẶP với REPUBLISHER_SCORING_LOST_MINUTES ngay dưới: trần này đong bằng SỐ LƯỢT đẩy lại
# = trần ÷ ngưỡng. Cũ 60'/15' ⇒ ~3 lượt; giữ 60' mà hạ ngưỡng còn 3' ⇒ ~20 lượt Gemini đốt cho
# một answer đã chết. 20'/3' ⇒ ~6 lượt. Đổi một cái mà không đổi cái kia là sai.
SCORING_GIVE_UP_AFTER_MINUTES=20
# Mốc coi worker MẤT TÍCH → đẩy lại job chấm. Đo prod 2026-08-20: cả 10 buổi vượt 120s đều do
# ngưỡng cũ 15' — độ trễ đẩy lại gom cụm ở 909-1025s (15' + chu kỳ quét 2'). 3' chứ không phải
# 90s: phải lớn hơn ca chấm chậm còn hợp lệ (chép lời ~24s + 3 lượt Gemini có retry ≈ 90s).
REPUBLISHER_SCORING_LOST_MINUTES=3

# ===== RAG grounding (D27 — InterviewService + Qdrant) =====
# Khoá Context7 để ingest tài liệu vào corpus (admin curate). Trống = không ingest được từ Context7.
CONTEXT7_API_KEY=your-context7-api-key

# BC18 — GitHub PAT để đọc repo public (scope tối thiểu: không cần scope nào / `public_repo`).
# RỖNG = GitHub API ẩn danh 60 req/h dùng chung theo IP server ⇒ ~7–15 lượt phân tích/giờ cho TOÀN BỘ
# người dùng rồi 429. Đặt token → 5000 req/h.
GITHUB_TOKEN=
# Bật retrieval lúc SINH (câu hỏi · lý thuyết · roadmap). Mặc định TẮT — chỉ bật sau khi đã nạp corpus,
# nếu không mọi request đều "ungrounded" mà vẫn tốn một vòng embed.
GROUNDING_ENABLED=false

# ===== FR18 — gom + flush số liệu HTTP (Gateway → PaymentService) =====
# Gateway gom theo cửa sổ rồi POST `/internal/http-traffic` sang Payment mỗi `FlushIntervalSeconds`
# (mặc định 300s). Đây là NGUỒN DUY NHẤT của bảng `http_traffic_stats` → dashboard admin traffic.
# Mặc định BẬT (khác các cờ rollout ở trên): đường này chỉ GHI số liệu vận hành, không đổi hành vi
# nghiệp vụ, không tốn token AI, không đụng tiền. Đặt `false` để tắt.
# ⚠ Hai vế còn lại của guard KHÔNG ở đây mà ghi cứng trong `deploy/compose.yaml` (khối gateway):
#   `Analytics__SinkBaseUrl` (phải là TÊN CONTAINER — mặc định `localhost:5271` parse được nhưng
#   sai trong container ⇒ hỏng im lặng) và `Internal__Token=${INTERNAL_TOKEN}` (dùng lại khoá trên).
#   Thiếu bất kỳ vế nào ⇒ `TrafficFlushService` thoát ngay lúc khởi động, KHÔNG có lỗi nào nổi lên.
# ⚠ DEP `Q5`: bật cờ ⇒ có nhiều bucket ⇒ endpoint admin analytics mới chạy nhánh đa-bucket (từng
#   500 trước khi Q5 vá). Q5 đã ở `main`; nếu rollback image Payment về trước đó thì tắt cờ này.
ANALYTICS_ENABLED=true

# ===== AIService (Python — aiapi + aiworker) =====
# Từ 2026-08-06 AIService chạy CÙNG compose với các service .NET (trước đó ở trên Mac qua Tailscale).
# Mọi địa chỉ nội bộ (S3/RabbitMQ/callback) đã ghi cứng tên service trong deploy/compose.yaml —
# ở đây chỉ còn bí mật và mấy cần gạt.
#
# ⚠ Đây là biến DUY NHẤT bắt buộc: thiếu → AIService chết ngay lúc import, không phải lỗi runtime.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# ⚠ Thiếu key → OpenAI 401 → RƠI ÂM THẦM về Whisper cục bộ (lỗi chép từ 0,7% lên 4,2%), KHÔNG
# sinh log lỗi nào. Kiểm bằng `practice_answers.transcript_engine` phải là `whisper-1`.
OPENAI_API_KEY=your-openai-api-key
TRANSCRIBE_PROVIDER=whisper-1
# Chủ động làm nóng cache câu seed/adaptive; tắt để rollback mà không đổi image.
# Đo tách chặng: một dòng `[⏱]` mỗi request của /decide-next. false = tắt hẳn (record no-op).
TIMING_LOG_ENABLED=true

TTS_PREWARM_ENABLED=true
# 2 lane giúp câu 4/5 ấm sớm hơn; không tăng tuỳ tiện vì Gemini TTS preview có quota.
TTS_PREWARM_CONCURRENCY=2
# Đợi mp3 của follow-up/clarify vào cache trước khi /decide-next trả câu hỏi cho browser.
TTS_ADAPTIVE_PREWARM_WAIT_SECONDS=15
# Chống nhiều AIService replica gọi Gemini trùng cùng một câu. Redis chỉ giữ lock/signal; mp3 vẫn
# ở SeaweedFS. false = quay về single-flight trong từng process, không làm mất cache audio.
TTS_REDIS_ENABLED=true
# Trần Gemini TTS + encode; phải thấp hơn lease Redis 120s để lock không hết khi owner còn chạy.
TTS_SYNTHESIS_TIMEOUT_SECONDS=60
# ⚠ Default TRONG CODE là `large-v3` = 2,9 GB tải về + 64-96s/lượt ⇒ vượt timeout decider 90s.
WHISPER_MODEL=small
# Cổng im lặng — VAD không thấy tiếng người ⇒ không chép lời, answer thành `Skipped` (không chấm,
# không trừ theo PAY-13). Mặc định BẬT vì đây là bản vá cho hành vi đã đo được là sai: bản ghi im
# lặng từng được Whisper "chép" thành câu quảng cáo rồi đem chấm điểm thật (prod 2026-08-15).
SILENCE_GATE_ENABLED=true
# Trần thread cho việc CHẶN (đọc S3 + chép lời). 0 = mặc định asyncio = min(32, cpu+4) = 12 trên
# server 8 core. **32 = giá trị production**, đo 2026-08-06: 3,22 → 5,16 req/s (+60%), p95 −28%.
# ⚠ ĐỪNG đặt 64: ở pool 32, tăng tải 32→48 chỉ được +3% ⇒ trần thật (~5 req/s) nằm SAU pool, thêm
# thread chỉ dài thêm hàng đợi. Muốn vượt thì bật `TRANSCRIBE_SEND_ORIGINAL` (payload 586 KB → ~60 KB).
# Đo lại trên phần cứng khác: `scripts/loadtest-ai-threadpool.py`.
AI_THREAD_POOL=32
SCORING_PREFETCH=10
# C14 sàng CV B2B. Trình tự bật BẮT BUỘC: deploy (tắt) → XẢ cv_screening_queue → true.
# Bật cùng lúc deploy = 713 lượt Gemini cho 8 ứng viên (republisher đã nhân bản, đo 2026-08-02).
CV_SCREENING_ENABLED=false

# ===== Chất lượng câu hỏi (SC1c) + cổng kiểm chứng (QV1) =====
# Hai cần gạt này BẬT MẶC ĐỊNH TRONG CODE (question_max_attempts=2) mà trước đây không có mặt ở đây
# lẫn trong compose ⇒ không thao tác được lúc chạy, phải sửa code + rebuild image mới tắt được.
#
# ⚠ KILL-SWITCH của SC1c là QUESTION_MAX_ATTEMPTS:
#   2 = bộ câu hỏi không phủ đủ tiêu chí thì TRẢ LẠI + sinh lại tối đa một lần (mỗi lần = 1 lượt
#       Gemini nữa, nằm TRONG request tạo buổi luyện);
#   1 = tắt hẳn việc sinh lại (vẫn giữ phần kiểm — hàm thuần, không tốn gì).
QUESTION_MAX_ATTEMPTS=2
# ⚠ KILL-SWITCH của QV1 là QUESTION_VERIFY_ENABLED. Bật lên ĐỔI HÌNH DẠNG cả đường sinh chứ không chỉ
# thêm một bước: corpus thôi không được cấp cho lượt SINH (chỉ dùng để KIỂM), và citations của kết quả
# đến TỪ lượt kiểm — lượt kiểm hỏng thì trả về KHÔNG có citation (cố ý, D27: không dựng citation giả).
# Cộng thêm MỘT lượt Gemini cho mỗi lần sinh câu hỏi. Mặc định TẮT, theo tiền lệ mọi rollout khác.
# ⚠ Chỉ có nghĩa khi GROUNDING_ENABLED=true VÀ corpus đã nạp — không có grounding thì nó là no-op.
QUESTION_VERIFY_ENABLED=false

# AI-CV1 — 512 giữ một ngân sách suy luận nhỏ cho đối chiếu CV/JD; 0 ưu tiên tốc độ tuyệt đối,
# -1 rollback về model tự quyết. Hai cap grounding phải giữ cùng giá trị để caller chọn
# round-robin và AIService vẫn có lớp phòng thủ cuối.
ANALYZE_CV_THINKING_BUDGET=512
# Trần suy luận ẩn cho lượt CHẤM. Đo prod 2026-08-20 (`ai_usage_logs`): `score` có output p50
# 3.570 token còn `decide_next` (trần 0) chỉ 126; nội dung nhìn thấy được đo trong DB chỉ ~1.000
# ⇒ ~2.500 token là thinking, và đó là phần lớn 19,6s p50 của một lượt chấm.
# ⚠ Đổi số này là đổi THƯỚC ĐO. Chạy `scripts/benchmark-scoring.py` (chấm lại câu THẬT, có đo sàn
# nhiễu) rồi mới chốt — đừng hạ về 0 chỉ vì `decide_next` hạ được. `-1` = quay lui.
SCORE_THINKING_BUDGET=512
# Thử lại lỗi Gemini TẠM THỜI (503/429/500/504, đứt mạng) ngay tại chỗ, thay vì để message rơi vào
# DLQ rồi chờ `StuckAnswerRepublisher` 15 phút — đúng ca đã bắt được trong log aiworker prod.
# ⚠ Chokepoint này nằm trên cả `/decide-next` (đồng bộ trong request upload, timeout 90s phía
# .NET) nên tổng thời gian chờ thêm phải ≤ ~5s. Mặc định 1s + 2s = 3s. `1` = tắt hẳn.
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=1.0
ANALYZE_CV_MAX_GROUNDING_CHUNKS=8
CV_ANALYSIS_MAX_GROUNDING_CHUNKS=8

# ===== Mạng / public =====
# IP Tailscale của SERVER — dùng cho thao tác ops qua tailnet và cho ĐƯỜNG LÙI chạy aiworker trên Mac.
# 🔴 KHÔNG còn cấp `Internal__CallbackBase` (C14): aiworker nay chạy trên server nên callback đi bằng
# tên container. Ghi chú cũ ở đây nói giữ dạng IP để "đường lùi về Mac không phải đụng tới nó" —
# nghe hợp lý nhưng SAI: container trên bridge network không tới được IP Tailscale của chính host,
# nên nó làm sàng lọc CV B2B chết im lặng. Xem DEPLOYMENT.md §C14.
SERVER_TS_IP=100.64.204.33
# URL public của gateway (cloudflare tunnel / domain) — dùng cho CORS + swagger.
GATEWAY_PUBLIC_URL=https://your-tunnel.trycloudflare.com

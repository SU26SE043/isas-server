# ISAS — Server .env (mẫu) — đặt CẠNH docker-compose.yml trên server, `chmod 600`.
# Copy → `.env`, điền giá trị THẬT. KHÔNG commit `.env` thật (đã gitignore).
# ⚠ Docker: giá trị KHÔNG bọc dấu nháy (compose truyền nguyên cả "..." vào biến).
# Chi tiết deploy: DEPLOYMENT.md. Secret phải KHỚP: xem DEPLOYMENT.md §3.

# ===== Postgres (container local) =====
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# ===== JWT (PHẢI GIỐNG HỆT ở auth · interview · campaign · payment) =====
# Interview/Campaign/Payment validate token do Auth phát bằng chung key này.
JWT_KEY=change-me-long-random-secret

# ===== Internal token (PHẢI GIỐNG interview ↔ aiservice-worker ↔ payment) =====
# Xác thực callback máy-máy /internal/... (không JWT).
INTERNAL_TOKEN=change-me-internal-token

# ===== SeaweedFS S3 (khớp seaweed-s3.json + phía Mac worker) =====
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me-s3-secret

# ===== RabbitMQ =====
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ===== SMTP (AuthService gửi email OTP / reset) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
SMTP_FROM=no-reply@example.com

# ===== Google OAuth (AuthService login-google) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Origin app FE — callback Google 302 về {FRONTEND_BASE_URL}/auth/google/callback kèm token ở fragment.
# BẮT BUỘC lấy từ config server: nhận đích redirect do client truyền = open-redirect làm rò token.
FRONTEND_BASE_URL=https://your-frontend
# Origin CÔNG KHAI của gateway KÈM /api/v1 — dùng dựng redirect_uri gửi Google (gateway strip tiền tố
# nên URL handler tự dựng sẽ thiếu /api/v1 và 404 ở edge). Phải khớp "Authorized redirect URI" khai
# trên Google Cloud Console: {GATEWAY_PUBLIC_BASE_URL}/auth/signin-google
GATEWAY_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com/api/v1

# ===== PayOS (PaymentService — mua credit + webhook) =====
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# BF3 — bắt buộc: PayOS reject tạo payment-link nếu return/cancel URL null. URL FE/tunnel redirect sau thanh toán.
PAYOS_RETURN_URL=https://your-frontend-or-tunnel/payment/success
PAYOS_CANCEL_URL=https://your-frontend-or-tunnel/payment/cancel

# ===== Mạng / public =====
# IP Tailscale của Mac chạy AIService (gateway + interview + campaign gọi sinh câu hỏi).
MAC_TS_IP=100.x.y.z
# URL public của gateway (cloudflare tunnel / domain) — dùng cho CORS + swagger.
GATEWAY_PUBLIC_URL=https://your-tunnel.trycloudflare.com

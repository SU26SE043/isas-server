        <mxCell id="title" value="Phân tích CV theo yêu cầu JD — luồng FE&#10;repo: isas-web-client (React)   ·   chi tiết API: cv-jd-requirements-api.drawio" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="620" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="bước đã có" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="MỚI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="810" y="20" width="70" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="cần sửa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="20" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="① = số API trong bảng" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="46" width="280" height="16" as="geometry" />
        </mxCell>

        <mxCell id="route1" value="&lt;b&gt;Route&lt;/b&gt;  /candidate/cv/analysis&#10;CVAnalysisPage + CvAnalysisStepper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st1" value="&lt;b&gt;domain&lt;/b&gt;      CvDomainStep&#10;chọn BA / BE / FE  →  jobCategory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="340" height="52" as="geometry" />
        </mxCell>

        <mxCell id="st2" value="&lt;b&gt;upload&lt;/b&gt;      UploadCV&#10;chọn CV có sẵn hoặc upload mới  →  cvId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="apiA" value="① GET  /files/files&#10;   POST /files/upload" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="252" width="250" height="48" as="geometry" />
        </mxCell>

        <mxCell id="st3" value="&lt;b&gt;github&lt;/b&gt;      CvGitHubStep&#10;&lt;i&gt;không liên quan tính năng này&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="340" height="52" as="geometry" />
        </mxCell>

        <mxCell id="st4" value="&lt;b&gt;job-description&lt;/b&gt;   UploadJD / CvJdTextPanel&#10;dán jdText  HOẶC  chọn file jdId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="410" width="340" height="52" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Nhờ AI tách JD?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="500" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="st5" value="&lt;b&gt;requirements&lt;/b&gt;   ⭐ BƯỚC MỚI&#10;2 danh sách sửa được: Bắt buộc có · Nên có" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="620" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="apiB" value="② POST /practice/jd-requirements&#10;   miễn phí · 429 nếu gọi nhiều" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="530" width="250" height="48" as="geometry" />
        </mxCell>

        <mxCell id="st6" value="&lt;b&gt;analysis&lt;/b&gt;    AnalyzeButton + CvAnalysisCreditDialog&#10;xác nhận dùng 1 lượt → gọi phân tích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="710" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="apiC" value="③ POST /practice/cv-analysis&#10;   TRỪ 1 CREDIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="712" width="250" height="48" as="geometry" />
        </mxCell>

        <mxCell id="st7" value="&lt;b&gt;report&lt;/b&gt;      CvAnalysisReportDetail&#10;⚠ JDMatchCard + CvMatchScoreRing phải ẨN khi jdMatch = null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="790" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="route2" value="&lt;b&gt;Route&lt;/b&gt;  /candidate/cv/analysis/report&#10;CVResultPage — lịch sử + xem lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="900" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="apiD" value="④ GET /practice/cv-analysis        (bản gọn)&#10;⑤ GET /practice/cv-analysis/{id}   (đầy đủ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="900" width="290" height="48" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Việc phải làm ở FE&lt;/b&gt;&#10;1. Thêm 'requirements' vào type CvAnalysisStep + mảng CV_TIMELINE_STEPS + key dịch cv.step.*&#10;2. Thêm endpoint jdRequirements vào cvAnalysis.endpoints.ts&#10;3. statusToCode() trong cvAnalysis.service.ts CHƯA map 429 → thêm mã 'rateLimited'&#10;4. AnalyzeCvRequest += mustHave? / niceToHave?  ·  CvAnalysisResult += 5 field mới&#10;5. Report: ẩn JDMatchCard/CvMatchScoreRing khi jdMatch = null, hiện bảng đối chiếu thay vào" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=16;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="940" height="130" as="geometry" />
        </mxCell>


        <!-- Right column -->
        <mxCell id="x_gemini" value="&lt;b&gt;Google Gemini&lt;/b&gt;&#10;LLM (questions · scoring · CV/repo analysis ·&#10;adaptive follow-up · roadmap &amp; lessons)&#10;+ TTS voice + text embeddings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1490" y="330" width="260" height="110" as="geometry" />

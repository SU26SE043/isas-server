        <mxCell id="x_payos" value="&lt;b&gt;PayOS&lt;/b&gt; (live, real money)&#10;collect channel: payment link + webhook&#10;payout channel: automated refunds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;fontSize=11;" vertex="1" parent="1">

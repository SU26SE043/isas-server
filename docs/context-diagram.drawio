        <mxCell id="x_ai_note" value="AI vendor calls leave ISAS only from &lt;b&gt;AIService&lt;/b&gt;&#10;(internal-only, GEN-7). Transcription vendor is&#10;switchable by config: whisper-1 · Gemini · local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;dashed=1;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1465" y="632" width="300" height="56" as="geometry" />
        </mxCell>


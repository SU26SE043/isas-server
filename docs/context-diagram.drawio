        <mxCell id="x_openai" value="&lt;b&gt;OpenAI Audio API&lt;/b&gt;&#10;speech-to-text (whisper-1)&#10;active provider; falls back to&#10;local Whisper inside AIService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">

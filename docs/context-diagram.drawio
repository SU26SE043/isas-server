<mxfile host="app.diagrams.net" modified="2026-08-10T00:00:00.000Z" agent="ISAS-system-architect" version="24.0.0" type="device">
  <diagram id="isas-system-context" name="ISAS System Context (§1)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="ISAS — System Context Diagram · §1 Product Overview" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#212121;" vertex="1" parent="1">
          <mxGeometry x="640" y="16" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND / NOTE ============ -->
        <mxCell id="note" value="&lt;b&gt;Legend &amp; notes&lt;/b&gt; (đối chiếu code 2026-08-10)&#10;• Center bubble = the system in scope (ISAS). Surrounding rectangles = external entities (human actors + external systems).&#10;• Each arrow = one &lt;b&gt;named data flow&lt;/b&gt;, single direction, labeled with the data it carries — an arrow INTO ISAS is an input, an arrow OUT is an output.&#10;• Only &lt;b&gt;3 platform roles&lt;/b&gt;: Candidate · Employer · Admin. OrgAdmin / HrMember are &lt;b&gt;org sub-roles&lt;/b&gt; (no separate &quot;HR&quot; / &quot;Organization&quot; role).&#10;• The &lt;b&gt;Angular SPA&lt;/b&gt; (hosted on Vercel) is part of ISAS — actors reach the system through it, via the Gateway.&#10;• &lt;b&gt;AuthService&lt;/b&gt; (JWT + Google OAuth) is INSIDE ISAS. &lt;b&gt;AIService&lt;/b&gt; is internal-only (GEN-7) and is the &lt;b&gt;only&lt;/b&gt; caller of Gemini/OpenAI.&#10;• &lt;b&gt;GitHub&lt;/b&gt; and &lt;b&gt;Context7&lt;/b&gt; are called &lt;b&gt;directly by InterviewService&lt;/b&gt;, not through AIService.&#10;• Self-hosted infra is INSIDE the boundary → not external entities: &lt;b&gt;PostgreSQL&lt;/b&gt; (DB-per-service) · &lt;b&gt;RabbitMQ&lt;/b&gt; · &lt;b&gt;SeaweedFS/S3&lt;/b&gt; · &lt;b&gt;Qdrant&lt;/b&gt; (RAG vectors).&#10;&#160;&#160;Redis is deployed in compose but &lt;b&gt;no service code uses it yet&lt;/b&gt;. Face-verify runs a &lt;b&gt;local&lt;/b&gt; InsightFace model — no external face API.&#10;• No external monitoring/analytics vendor: traffic + AI-cost metering (FR18/F22) are stored in ISAS&apos;s own databases." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="500" height="228" as="geometry" />
        </mxCell>

        <!-- ============ CENTRAL SYSTEM (bubble) ============ -->
        <mxCell id="isas" value="&lt;b&gt;ISAS&lt;/b&gt;&#10;AI Interview Platform&#10;&#10;B2C practice + B2B assessment&#10;(one shared engine)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8E63CE;strokeColor=#5E35B1;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="240" height="240" as="geometry" />
        </mxCell>

        <!-- ============ EXTERNAL ENTITIES — HUMAN ACTORS (blue, left) ============ -->
        <mxCell id="a_candidate" value="&lt;b&gt;Candidate&lt;/b&gt;&#10;(B2C learner + B2B applicant)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a_employer" value="&lt;b&gt;Employer&lt;/b&gt;&#10;(business user)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="600" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a_emp_note" value="&lt;b&gt;Org sub-roles&lt;/b&gt; (within an Organization):&#10;• &lt;b&gt;OrgAdmin&lt;/b&gt; — billing, buy credits, manage members&#10;• &lt;b&gt;HrMember&lt;/b&gt; — manage campaigns / ranking, NO billing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#64B5F6;dashed=1;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="686" width="265" height="92" as="geometry" />
        </mxCell>

        <mxCell id="a_admin" value="&lt;b&gt;Platform Admin&lt;/b&gt;&#10;(packages · orders · orgs · users)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="900" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ============ EXTERNAL ENTITIES — THIRD-PARTY SYSTEMS ============ -->

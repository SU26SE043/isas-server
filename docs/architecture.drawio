        <!-- ============ LEGEND ============ -->
        <mxCell id="legend" value="&lt;b&gt;CHÚ THÍCH — LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; HTTP public qua Gateway (/api/v1/*)&lt;br&gt;&lt;font color=&quot;#E65100&quot;&gt;&lt;b&gt;╍╍&lt;/b&gt;&lt;/font&gt; HTTP nội bộ /internal/* (X-Internal-Token) — KHÔNG qua gateway&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;╍╍&lt;/b&gt;&lt;/font&gt; RabbitMQ — job chấm (scoring_pipeline_queue) + event bus (interview.events)&lt;br&gt;&lt;font color=&quot;#757575&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; Kết nối hạ tầng (DB-per-service / S3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#616161;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="480" width="400" height="150" as="geometry" />
        </mxCell>


        <mxCell id="interview" value="InterviewService (.NET)&lt;br&gt;&lt;b&gt;ENGINE PHỎNG VẤN DÙNG CHUNG&lt;/b&gt;&lt;br&gt;&lt;b&gt;B2C + B2B&lt;/b&gt;  (campaign_id null = B2C)&lt;br&gt;session · câu hỏi · câu trả lời&lt;br&gt;điểm · rubric/tiêu chí · file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;strokeWidth=3;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="270" height="150" as="geometry" />
        </mxCell>


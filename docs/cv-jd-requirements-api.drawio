          <mxGeometry x="1130" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ============ TYPE ============ -->
        <mxCell id="ty" value="&lt;b&gt;KIỂU DỮ LIỆU&lt;/b&gt;  — tên type theo cvAnalysis.types.ts của isas-web-client&#10;(uuid/ISO-8601 đều là string · `?` = optional/null · ⭐ = field phải THÊM)&#10;&#10;FileRecord {   // đã có&#10;  id · fileType · originalName · mimeType: string · fileSize: number&#10;  parsedStatus: string · createdAt: string · updatedAt?: string&#10;}&#10;&#10;⭐ JdRequirement    { text: string; citations: Citation[] }&#10;⭐ RequirementInput { requirementId: string; text: string }   // ≤ 500 ký tự · xem N7&#10;&#10;⚠ HAI kiểu citation KHÁC NHAU:&#10;⭐ Citation           { chunkId, sourceUrl, sourceTitle: string }        ← bước ② (KHÔNG có content)&#10;⭐ CvAnalysisCitation { chunkId, content: string; sourceUrl?, sourceTitle?: string }  ← bước ③/⑤&#10;&#10;AnalyzeCvRequest {          // đã có — thêm 2 field&#10;  cvId: string&#10;  jobCategory: string       // &quot;BA&quot; | &quot;BE&quot; | &quot;FE&quot;&#10;  jdId?: string&#10;  jdText?: string&#10;⭐ mustHave?:   RequirementInput[]&#10;⭐ niceToHave?: RequirementInput[]&#10;}&#10;&#10;CvAnalysisResult {          // đã có — thêm 5 field&#10;  id · cvId: string · jdId: string | null · jobCategory · createdAt: string&#10;  summary: string · strengths · weaknesses · suggestions: string[]&#10;  jdMatch: JdMatch | null           ← nay CÓ THỂ null ở chế độ mới (N3)&#10;⭐ requirementSummary: RequirementSummary | null&#10;⭐ mustHaveMatches:   RequirementMatch[] | null&#10;⭐ niceToHaveMatches: RequirementMatch[] | null&#10;⭐ cvSections: CvSectionAnchor[] | null&#10;⭐ citations:  CvAnalysisCitation[] | null&#10;}&#10;&#10;JdMatch            { score: number /*0-100*/; matchedSkills: string[]; missingSkills: string[] }&#10;⭐ RequirementSummary { mustHave: LevelCount; niceToHave: LevelCount }&#10;⭐ LevelCount         { total: number; strong: number; partial: number; weak: number }&#10;&#10;⭐ RequirementMatch {          // ⚠ PHẲNG — không có object `evidence`, không có `verified`&#10;  requirementId: string&#10;  priority: &quot;MustHave&quot; | &quot;NiceToHave&quot;&#10;  text:     string&#10;  level:    &quot;Strong&quot; | &quot;Partial&quot; | &quot;Weak&quot;&#10;  evidence: string           // trích NGUYÊN VĂN từ CV, hoặc hằng &quot;Không thấy bằng chứng&quot;&#10;  page:         number | null   // số trang PDF — null khi không có bằng chứng&#10;  sectionTitle: string | null   // vd &quot;Kinh nghiệm&quot; — null khi không có bằng chứng&#10;}&#10;⭐ CvSectionAnchor { title: string; kind: string; startsWith: string }&#10;   ↳ `startsWith` là chuỗi neo để SERVER tự định vị mục; KHÔNG phải số trang.&#10;&#10;Bản GỌN của ④ (CvAnalysisListResponse):&#10;  BỎ HẲN cvSections + citations; 2 mảng match đổi kiểu sang&#10;  ⭐ CvRequirementListItem { requirementId, priority, text, level: string }&#10;  (tức mất evidence · page · sectionTitle) — giữ requirementSummary." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="740" height="820" as="geometry" />
        </mxCell>

        <!-- ============ BẢNG 2: LỖI ============ -->
        <mxCell id="t2title" value="Lỗi FE phải xử" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="800" width="300" height="24" as="geometry" />
